#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$root"
sha256sum -c SHA256SUMS >/dev/null
mkdir -p home /run/lock
audio=dummy
if [ "${1:-}" = "--audio" ]; then
  shift
  if [ ! -c /dev/MrAudio ] || [ ! -w /dev/MrAudio ]; then
    printf '%s\n' 'MiSTer audio requires writable /dev/MrAudio and an audio-enabled core.' >&2
    exit 1
  fi
  audio=alsa
fi
exec env -i PATH=/usr/bin:/bin HOME="$root/home" LANG=C SDL_VIDEODRIVER=dummy SDL_VIDEO_DRIVER=dummy \
  SDL_AUDIODRIVER="$audio" SDL_AUDIO_DRIVER="$audio" ALSA_CONFIG_PATH="$root/asound.conf" \
  "$root/lib/ld-linux-armhf.so.3" --library-path "$root/lib" "$root/bin/dosbox-x" \
  -conf "$root/dosbox-x.conf" "$@"
