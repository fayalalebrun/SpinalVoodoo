pub fn reciprocal(index: u9) -> u17 {
    RECIPROCAL_TABLE[if index > u9:256 { u9:256 } else { index }]
}

#[test]
fn reciprocal_table_matches_formula() {
    for (index, _): (u10, ()) in u10:0..u10:257 {
        let denominator = u32:256 + (index as u32);
        assert_eq(
            reciprocal(index as u9),
            ((u32:0x01000000 + (denominator >> u8:1)) / denominator) as u17);
    }(())
}

#[test]
fn lookup_boundaries() {
    assert_eq(log_fraction(u8:0), u8:0);
    assert_eq(log_fraction(u8:128), u8:0x95);
    assert_eq(log_fraction(u8:255), u8:0xff);
    assert_eq(reciprocal(u9:0), u17:0x10000);
    assert_eq(reciprocal(u9:256), u17:0x8000);
}
