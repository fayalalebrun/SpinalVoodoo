diff --git a/xls/jit/jit_channel_queue_test.cc b/xls/jit/jit_channel_queue_test.cc
index c612084..2569adf 100644
--- a/xls/jit/jit_channel_queue_test.cc
+++ b/xls/jit/jit_channel_queue_test.cc
@@ -197,5 +197,41 @@ TYPED_TEST(JitChannelQueueTest, IotaGeneratorWithRawApi) {
                                  "a generator function")));
 }
 
+TYPED_TEST(JitChannelQueueTest, RawGeneratorAvoidsValueConversion) {
+  Package package("test");
+  XLS_ASSERT_OK_AND_ASSIGN(
+      Channel * channel,
+      package.CreateStreamingChannel("my_channel", ChannelOps::kSendReceive,
+                                     package.GetBitsType(32)));
+  XLS_ASSERT_OK_AND_ASSIGN(ProcElaboration elaboration,
+                           ProcElaboration::ElaborateOldStylePackage(&package));
+
+  JitRuntimeInfo<TypeParam> info(
+      elaboration.GetUniqueInstance(channel).value());
+  TypeParam& queue = *info.jit_queue;
+
+  uint32_t counter = 42;
+  XLS_ASSERT_OK(queue.AttachRawGenerator([&](uint8_t* buffer) {
+    memcpy(buffer, &counter, sizeof(counter));
+    ++counter;
+    return true;
+  }));
+
+  auto read_u32 = [&]() {
+    std::vector<uint8_t> recv_buffer(4);
+    EXPECT_TRUE(queue.ReadRaw(recv_buffer.data()));
+    uint32_t result;
+    memcpy(&result, recv_buffer.data(), sizeof(result));
+    return result;
+  };
+
+  EXPECT_EQ(read_u32(), 42);
+  EXPECT_EQ(read_u32(), 43);
+  EXPECT_THAT(queue.Write(Value(UBits(22, 32))),
+              StatusIs(absl::StatusCode::kInternal,
+                       HasSubstr("Cannot write to ChannelQueue because it has "
+                                 "a generator function")));
+}
+
 }  // namespace
 }  // namespace xls

