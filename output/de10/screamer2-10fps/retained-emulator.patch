 	*(uint32_t*)data=( (*(uint32_t*)data) & 0xff000000 ) | ( ( ((uint32_t)cache.pos - (data+8)) >> 2 ) & 0x00ffffff );
 }
+
+#if C_TARGETCPU == ARMV7LE && !defined(WORDS_BIGENDIAN)
+#define DRC_SHARED_MEMORY_HELPERS
+static uint8_t* memory_helpers[2][3];
+static void gen_memory_helpers();
+
+static void gen_call_memory_helper(bool write, unsigned width) {
+	const int64_t delta = (int64_t)(uintptr_t)cache_rwtox(memory_helpers[write][width >> 1]) - (int64_t)(uintptr_t)cache_rwtox(cache.pos + 8);
+	if ((delta & 3) || delta < -0x2000000 || delta >= 0x2000000)
+		E_Exit("Memory helper branch out of range");
+	cache_addd(0xeb000000 | ((delta >> 2) & 0x00ffffff));
+}
+
+template <typename T> static void gen_memory_helper(bool write, unsigned width, void* tlb, const T slow) {
+	memory_helpers[write][width >> 1] = cache.pos;
+	uint32_t unaligned = 0;
+	if (width != 1) {
+		cache_addd(TST_IMM(FC_OP1, width - 1, 0));
+		unaligned = (uint32_t)cache.pos;
+		cache_addd(BNE_FWD(0));
+	}
+	cache_addd(MOVW(temp1, ((uint32_t)tlb) & 0xffff));
+	cache_addd(MOVT(temp1, ((uint32_t)tlb) >> 16));
+	cache_addd(MOV_REG_LSR_IMM(HOST_r2, FC_OP1, 12));
+	cache_addd(LDR_REG_LSL_IMM(temp1, temp1, HOST_r2, 2));
+	const uint32_t indirect = gen_create_branch_on_zero(temp1, true);
+	cache_addd(ADD_REG_LSL_IMM(temp1, temp1, FC_OP1, 0));
+	if (write) {
+		cache_addd(width == 4 ? STR_IMM(FC_OP2, temp1, 0) : width == 2 ? STRH_IMM(FC_OP2, temp1, 0) : STRB_IMM(FC_OP2, temp1, 0));
+	} else {
+		cache_addd(width == 4 ? LDR_IMM(HOST_r2, temp1, 0) : width == 2 ? LDRH_IMM(HOST_r2, temp1, 0) : LDRB_IMM(HOST_r2, temp1, 0));
+		cache_addd(width == 4 ? STR_IMM(HOST_r2, readdata_addr, 0) : width == 2 ? STRH_IMM(HOST_r2, readdata_addr, 0) : STRB_IMM(HOST_r2, readdata_addr, 0));
+	}
+	cache_addd(MOV_IMM(FC_RETOP, 0, 0));
+	cache_addd(BX(HOST_lr));
+	if (width != 1) gen_fill_branch(unaligned);
+	gen_fill_branch(indirect);
+	cache_addd(MOVW(temp1, ((uint32_t)slow) & 0xffff));
+	cache_addd(MOVT(temp1, ((uint32_t)slow) >> 16));
+	cache_addd(BX(temp1));
+}
+#endif
 
