+template <BranchTypes branch>
+static inline bool dynrec_test_flags(bool cf, bool zf, bool sf, bool of) {
+	bool result;
+	switch (branch & ~1) {
+	case BR_O: result = of; break;
+	case BR_B: result = cf; break;
+	case BR_Z: result = zf; break;
+	case BR_BE: result = cf || zf; break;
+	case BR_S: result = sf; break;
+	case BR_L: result = sf != of; break;
+	case BR_LE: result = zf || (sf != of); break;
+	default: result = get_PF() != 0; break;
+	}
+	return result != bool(branch & 1);
+}
+
+template <BranchTypes branch, typename T, int operation>
+static inline bool dynrec_test_result() {
+	const uint32_t a = T(lf_var1d), b = T(lf_var2d), r = T(lf_resd);
+	const uint32_t sign = uint32_t(T(-1)) / 2 + 1;
+	bool cf = false, of = false;
+	switch (operation) {
+	case t_ORb: break;
+	case t_ADDb:
+		cf = r < a;
+		of = ((a ^ b ^ sign) & (r ^ b) & sign) != 0;
+		break;
+	case t_SUBb:
+		cf = a < b;
+		of = ((a ^ b) & (a ^ r) & sign) != 0;
+		break;
+	case t_INCb: cf = GETFLAG(CF) != 0; of = r == sign; break;
+	case t_DECb: cf = GETFLAG(CF) != 0; of = r == sign - 1; break;
+	case t_NEGb: cf = a != 0; of = a == sign; break;
+	}
+	return dynrec_test_flags<branch>(cf, r == 0, (r & sign) != 0, of);
+}
+
+template <BranchTypes branch>
+static inline bool dynrec_test_branch() {
+	if ((branch & ~1) == BR_P) return (get_PF() != 0) != bool(branch & 1);
+	switch (lflags.type) {
+	case t_UNKNOWN:
+		return dynrec_test_flags<branch>(GETFLAG(CF), GETFLAG(ZF), GETFLAG(SF), GETFLAG(OF));
+	case t_ADDb: return dynrec_test_result<branch, uint8_t, t_ADDb>();
+	case t_ADDw: return dynrec_test_result<branch, uint16_t, t_ADDb>();
+	case t_ADDd: return dynrec_test_result<branch, uint32_t, t_ADDb>();
+	case t_SUBb: case t_CMPb: return dynrec_test_result<branch, uint8_t, t_SUBb>();
+	case t_SUBw: case t_CMPw: return dynrec_test_result<branch, uint16_t, t_SUBb>();
+	case t_SUBd: case t_CMPd: return dynrec_test_result<branch, uint32_t, t_SUBb>();
+	case t_ORb: case t_ANDb: case t_XORb: case t_TESTb:
+		return dynrec_test_result<branch, uint8_t, t_ORb>();
+	case t_ORw: case t_ANDw: case t_XORw: case t_TESTw:
+		return dynrec_test_result<branch, uint16_t, t_ORb>();
+	case t_ORd: case t_ANDd: case t_XORd: case t_TESTd:
+		return dynrec_test_result<branch, uint32_t, t_ORb>();
+	case t_INCb: return dynrec_test_result<branch, uint8_t, t_INCb>();
+	case t_INCw: return dynrec_test_result<branch, uint16_t, t_INCb>();
+	case t_INCd: return dynrec_test_result<branch, uint32_t, t_INCb>();
+	case t_DECb: return dynrec_test_result<branch, uint8_t, t_DECb>();
+	case t_DECw: return dynrec_test_result<branch, uint16_t, t_DECb>();
+	case t_DECd: return dynrec_test_result<branch, uint32_t, t_DECb>();
+	case t_NEGb: return dynrec_test_result<branch, uint8_t, t_NEGb>();
+	case t_NEGw: return dynrec_test_result<branch, uint16_t, t_NEGb>();
+	case t_NEGd: return dynrec_test_result<branch, uint32_t, t_NEGb>();
+	}
+	switch (branch) {
+	case BR_O: return TFLG_O;
+	case BR_NO: return TFLG_NO;
+	case BR_B: return TFLG_B;
+	case BR_NB: return TFLG_NB;
+	case BR_Z: return TFLG_Z;
+	case BR_NZ: return TFLG_NZ;
+	case BR_BE: return TFLG_BE;
+	case BR_NBE: return TFLG_NBE;
+	case BR_S: return TFLG_S;
+	case BR_NS: return TFLG_NS;
+	case BR_P: return TFLG_P;
+	case BR_NP: return TFLG_NP;
+	case BR_L: return TFLG_L;
+	case BR_NL: return TFLG_NL;
+	case BR_LE: return TFLG_LE;
+	case BR_NLE: return TFLG_NLE;
+	}
+	return false;
+}
