#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
"$root/scripts/test-quartus-compat-xls-rtl"
"$root/scripts/gen-rtl-de10-xls"
iverilog -g2012 -s XlsAvalonTransferMasterTb \
  -o "$root/xls/build/xls-avalon-transfer-tb" \
  "$root/hw/de10/xls/XlsAvalonTransferMaster.sv" \
  "$root/hw/de10/rtl/XlsAvalonTransferMasterCore.v" \
  "$root/hw/de10/xls/XlsAvalonTransferMaster_tb.sv"
vvp "$root/xls/build/xls-avalon-transfer-tb"
iverilog -g2012 -s XlsAvalonReadWriteMasterTb \
  -o "$root/xls/build/xls-avalon-read-write-tb" \
  "$root/hw/de10/xls/XlsAvalonTransferMaster.sv" \
  "$root/hw/de10/xls/XlsAvalonReadWriteMaster.sv" \
  "$root/hw/de10/rtl/XlsAvalonTransferMasterCore.v" \
  "$root/hw/de10/xls/XlsAvalonReadWriteMaster_tb.sv"
vvp "$root/xls/build/xls-avalon-read-write-tb"

iverilog -g2012 -s XlsFramebufferReadCacheTb \
  -o "$root/xls/build/xls-framebuffer-read-cache-tb" \
  "$root/hw/de10/xls/XlsFramebufferReadCache.sv" \
  "$root/hw/de10/xls/XlsFramebufferReadCache_tb.sv"
vvp "$root/xls/build/xls-framebuffer-read-cache-tb"
iverilog -g2012 -s XlsFramebufferReadPrefetchTb \
  -o "$root/xls/build/xls-framebuffer-read-prefetch-tb" \
  "$root/hw/de10/xls/XlsFramebufferReadPrefetch.sv" \
  "$root/hw/de10/xls/XlsFramebufferReadPrefetch_tb.sv"
vvp "$root/xls/build/xls-framebuffer-read-prefetch-tb"
iverilog -g2012 -s XlsFramebufferSpanReaderTb \
  -o "$root/xls/build/xls-framebuffer-span-reader-tb" \
  "$root/hw/de10/xls/XlsFramebufferSpanReader.sv" \
  "$root/hw/de10/xls/XlsFramebufferSpanReader_tb.sv"
vvp "$root/xls/build/xls-framebuffer-span-reader-tb"
iverilog -g2012 -s XlsFramebufferWriteBufferTb \
  -o "$root/xls/build/xls-framebuffer-write-buffer-tb" \
  "$root/hw/de10/xls/XlsFramebufferWriteBuffer.sv" \
  "$root/hw/de10/xls/XlsFramebufferWriteBuffer_tb.sv"
vvp "$root/xls/build/xls-framebuffer-write-buffer-tb"
iverilog -g2012 -s XlsFramebufferWriteIngressTb \
  -o "$root/xls/build/xls-framebuffer-write-ingress-tb" \
  "$root/hw/de10/xls/XlsFramebufferWriteBuffer.sv" \
  "$root/hw/de10/xls/XlsFramebufferWriteIngress.sv" \
  "$root/hw/de10/xls/XlsFramebufferWriteIngress_tb.sv"
vvp "$root/xls/build/xls-framebuffer-write-ingress-tb"
iverilog -g2012 -s XlsAvalonArbiter2Tb \
  -o "$root/xls/build/xls-avalon-arbiter2-tb" \
  "$root/hw/de10/xls/XlsAvalonArbiter2.sv" \
  "$root/hw/de10/xls/XlsAvalonArbiter2_tb.sv"
vvp "$root/xls/build/xls-avalon-arbiter2-tb"
iverilog -g2012 -s XlsH2fMemoryFifoTb \
  -o "$root/xls/build/xls-h2f-memory-fifo-tb" \
  "$root/hw/de10/xls/XlsH2fMemoryFifo.sv" \
  "$root/hw/de10/xls/XlsH2fMemoryFifo_tb.sv"
vvp "$root/xls/build/xls-h2f-memory-fifo-tb"
iverilog -g2012 -s XlsH2fCommandFifoTb \
  -o "$root/xls/build/xls-h2f-command-fifo-tb" \
  "$root/hw/de10/xls/XlsH2fMemoryFifo.sv" \
  "$root/hw/de10/xls/XlsH2fCommandFifo.sv" \
  "$root/hw/de10/xls/XlsH2fCommandFifo_tb.sv"
vvp "$root/xls/build/xls-h2f-command-fifo-tb"

iverilog -g2012 -s XlsPackedBankMemoryTb \
  -o "$root/xls/build/xls-packed-bank-tb" \
  "$root/hw/de10/xls/XlsPackedBankMemory.sv" \
  "$root/hw/de10/xls/XlsPackedBankMemory_tb.sv"
vvp "$root/xls/build/xls-packed-bank-tb"
iverilog -g2012 -s XlsPaletteMemoryTb \
  -o "$root/xls/build/xls-palette-tb" \
  "$root/hw/de10/xls/XlsPaletteMemory.sv" \
  "$root/hw/de10/xls/XlsPaletteMemory_tb.sv"
vvp "$root/xls/build/xls-palette-tb"
iverilog -g2012 -s XlsPerformanceCountersTb \
  -o "$root/xls/build/xls-performance-counters-tb" \
  "$root/hw/de10/xls/XlsPerformanceCounters.sv" \
  "$root/hw/de10/xls/XlsPerformanceCounters_tb.sv"
vvp "$root/xls/build/xls-performance-counters-tb"
iverilog -g2012 -s XlsRenderCycleProfilerTb \
  -o "$root/xls/build/xls-render-cycle-profiler-tb" \
  "$root/hw/de10/xls/XlsPerformanceCounters.sv" \
  "$root/hw/de10/xls/XlsRenderCycleProfiler_tb.sv"
vvp "$root/xls/build/xls-render-cycle-profiler-tb"
iverilog -g2012 -s XlsPipelineProfilerTb \
  -o "$root/xls/build/xls-pipeline-profiler-tb" \
  "$root/hw/de10/xls/XlsPipelineProfiler.sv" \
  "$root/hw/de10/xls/XlsPipelineProfiler_tb.sv"
vvp "$root/xls/build/xls-pipeline-profiler-tb"
verilator --lint-only --top-module XlsDe10Top \
  -Wno-WIDTHTRUNC -Wno-WIDTHEXPAND -Wno-UNSIGNED -Wno-CMPCONST \
  -Wno-MULTITOP -Wno-TIMESCALEMOD -Wno-PINCONNECTEMPTY \
  -Wno-UNUSEDSIGNAL -Wno-UNUSEDPARAM \
  "$root/hw/de10/xls/XlsDe10Top.sv" \
  "$root/hw/de10/xls/XlsFramebufferReadCache.sv" \
  "$root/hw/de10/xls/XlsFramebufferReadPrefetch.sv" \
  "$root/hw/de10/xls/XlsFramebufferSpanReader.sv" \
  "$root/hw/de10/xls/XlsFramebufferWriteBuffer.sv" \
  "$root/hw/de10/xls/XlsFramebufferWriteIngress.sv" \
  "$root/hw/de10/xls/XlsAvalonTransferMaster.sv" \
  "$root/hw/de10/xls/XlsAvalonReadWriteMaster.sv" \
  "$root/hw/de10/rtl/XlsAvalonTransferMasterCore.v" \
  "$root/hw/de10/xls/XlsPackedBankMemory.sv" \
  "$root/hw/de10/xls/XlsPackedBankMemoryVector.sv" \
  "$root/hw/de10/xls/XlsPaletteMemory.sv" \
  "$root/hw/de10/xls/XlsPerformanceCounters.sv" \
  "$root/hw/de10/xls/XlsPipelineProfiler.sv" \
  "$root/xls/build/core_sim_de10_rtl/CoreSimDe10.sv" \
  "$root/hw/de10/rtl/XlsDe10Scanout.v" \
  "$root/xls/rtl/VoodooXlsFramebufferAddress.v"
verilator --cc --exe --build -j 0 --top-module XlsDe10Top \
  --Mdir "$root/xls/build/xls-de10-top-mmio-verilator" \
  -Wno-WIDTHTRUNC -Wno-WIDTHEXPAND -Wno-UNSIGNED -Wno-CMPCONST \
  -Wno-MULTITOP -Wno-TIMESCALEMOD -Wno-PINCONNECTEMPTY \
  -Wno-UNUSEDSIGNAL -Wno-UNUSEDPARAM \
  "$root/hw/de10/xls/XlsDe10Top.sv" \
  "$root/hw/de10/xls/XlsFramebufferReadCache.sv" \
  "$root/hw/de10/xls/XlsFramebufferReadPrefetch.sv" \
  "$root/hw/de10/xls/XlsFramebufferSpanReader.sv" \
  "$root/hw/de10/xls/XlsFramebufferWriteBuffer.sv" \
  "$root/hw/de10/xls/XlsFramebufferWriteIngress.sv" \
  "$root/hw/de10/xls/XlsAvalonTransferMaster.sv" \
  "$root/hw/de10/xls/XlsAvalonReadWriteMaster.sv" \
  "$root/hw/de10/rtl/XlsAvalonTransferMasterCore.v" \
  "$root/hw/de10/xls/XlsPackedBankMemory.sv" \
  "$root/hw/de10/xls/XlsPackedBankMemoryVector.sv" \
  "$root/hw/de10/xls/XlsPaletteMemory.sv" \
  "$root/hw/de10/xls/XlsPerformanceCounters.sv" \
  "$root/hw/de10/xls/XlsPipelineProfiler.sv" \
  "$root/xls/build/core_sim_de10_rtl/CoreSimDe10.sv" \
  "$root/hw/de10/rtl/XlsDe10Scanout.v" \
  "$root/xls/rtl/VoodooXlsFramebufferAddress.v" \
  "$root/xls/verilator/xls_de10_top_mmio_testbench.cpp" \
  -CFLAGS -O2
"$root/xls/build/xls-de10-top-mmio-verilator/VXlsDe10Top"
