#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
build="$root/output/mister/glide-platform"
mkdir -p "$build"
make -C emu/mister -f Makefile.glide -j4 CC='gcc -m32' BUILD_DIR="$build/glide" "$build/glide/libglide2x.a"
flags=(-m32 -std=c11 -O2 -Wall -Wextra -Werror -pedantic -pthread)
gcc "${flags[@]}" -Dnanosleep=mister_sim_pause -Dclock_gettime=mister_sim_clock_gettime \
  -c emu/mister/mister_mailbox.c -o "$build/mailbox.o"
gcc "${flags[@]}" -c emu/mister/mister_runtime.c -o "$build/runtime.o"
verilator --cc --exe --top-module MisterPlatform \
  -Wno-WIDTHTRUNC -Wno-WIDTHEXPAND -Wno-UNSIGNED -Wno-CMPCONST -Wno-TIMESCALEMOD \
  -f hw/mister/xls-files.f output/mister/rtl/MisterPlatform.v \
  --Mdir "$build/model" "$root/hw/mister/platform_test.cpp" \
  "$build/glide/libglide2x.a" "$build/runtime.o" "$build/mailbox.o" \
  -CFLAGS "-m32 -O2 -Wall -Wextra -Werror -DMISTER_GLIDE_TEST=1 -I$root/emu/glide/glide2x/sst1/glide/src -I$root/emu/glide/glide2x/sst1/init -I$root/emu/glide/swlibs/fxmisc" \
  -LDFLAGS '-m32 -lz -lm -Wl,--wrap=mister_memory_open,--wrap=mister_memory_close'
make -C "$build/model" -f VMisterPlatform.mk -j4 -W "$root/hw/mister/platform_test.cpp"
timeout 480 "$build/model/VMisterPlatform"
