#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
scripts/gen-rtl-de10-xls
scala-cli --power run --server=false project.scala src --main-class voodoo.mister.MisterRtlGen
python3 scripts/prepare-mister-sources --check
verilator --lint-only --timing --top-module emu -DMISTER_FB=1 -Ioutput/mister/sources/template \
  -Wno-WIDTHTRUNC -Wno-WIDTHEXPAND -Wno-UNSIGNED -Wno-CMPCONST -Wno-TIMESCALEMOD \
  hw/mister/upstream-simulation.vlt -f hw/mister/xls-files.f output/mister/rtl/MisterCore.v \
  hw/mister/pll_sim.sv hw/mister/SpinalVoodoo.sv output/mister/sources/template/sys/hps_io.sv
flags=(--top-module MisterPlatform -Wno-WIDTHTRUNC -Wno-WIDTHEXPAND -Wno-UNSIGNED -Wno-CMPCONST -Wno-TIMESCALEMOD)
sources=(-f hw/mister/xls-files.f output/mister/rtl/MisterPlatform.v)
verilator --lint-only "${flags[@]}" "${sources[@]}"
cc -std=c11 -O2 -Wall -Wextra -Werror -pedantic -pthread -Dnanosleep=mister_sim_pause -Dclock_gettime=mister_sim_clock_gettime \
  -c emu/mister/mister_mailbox.c -o output/mister/platform-host.o
verilator --cc --exe --build -j "${MISTER_BUILD_JOBS:-4}" "${flags[@]}" "${sources[@]}" \
  --Mdir "$root/output/mister/platform-sim" "$root/hw/mister/platform_test.cpp" \
  "$root/output/mister/platform-host.o" -CFLAGS '-O2 -Wall -Wextra -Werror'
"$root/output/mister/platform-sim/VMisterPlatform"
