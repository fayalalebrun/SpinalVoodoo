#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
build="$root/xls/build"
rtl="$root/xls/rtl"
mkdir -p "$build" "$rtl"

for tool in interpreter_main ir_converter_main opt_main codegen_main dslx_fmt; do
  command -v "$tool" >/dev/null
done

if [[ "${1:-}" == "--de10-proc" ]]; then
  proc_build="$build/core_sim_de10_rtl"
  mkdir -p "$proc_build"
  ir_converter_main \
    --dslx_path="$root/xls/dslx" \
    --top=core_sim_de10 \
    --lower_to_proc_scoped_channels \
    "$root/xls/dslx/core_sim.x" >"$proc_build/unoptimized.ir"
  sed -E \
     -e '/^  chan _(texture_fill_response|texture_fill_transfer|texture_fill_transfer_response|triangle_setup_request)\(/ s/\)$/\, fifo_depth=0, bypass=true, register_push_outputs=false, register_pop_outputs=false)/' \
     -e '/^  chan _(texture_fill_response|texture_fill_transfer|texture_fill_transfer_response|triangle_setup_request)\(/b' \
    -e '/^  chan _triangle_setup_response\(/ s/\)$/\, fifo_depth=1, bypass=false, register_push_outputs=true, register_pop_outputs=false)/' \
    -e '/^  chan _triangle_setup_response\(/b' \
    -e '/^  chan _(pixel_work|pixel_result)\(/ s/\)$/\, fifo_depth=2, bypass=false, register_push_outputs=true, register_pop_outputs=false)/' \
    -e '/^  chan _(pixel_work|pixel_result)\(/b' \
    -e '/^  chan _pixel_read_job\(/ s/\)$/\, fifo_depth=2, bypass=false, register_push_outputs=true, register_pop_outputs=false)/' \
    -e '/^  chan _pixel_pending\(/ s/\)$/\, fifo_depth=12, bypass=false, register_push_outputs=true, register_pop_outputs=false)/' \
    -e '/^  chan _(pixel_read_job|pixel_pending)\(/b' \
    -e '/^  chan _texture_cache_request\(/ s/\)$/\, fifo_depth=0, bypass=true, register_push_outputs=false, register_pop_outputs=false)/' \
    -e '/^  chan _texture_cache_request\(/b' \
    -e '/^  chan _pixel_job\(/ s/\)$/\, fifo_depth=0, bypass=true, register_push_outputs=false, register_pop_outputs=false)/' \
    -e '/^  chan _pixel_job\(/b' \
    -e '/^  chan _framebuffer_pixel_read_response\(/ s/\)$/\, fifo_depth=2, bypass=false, register_push_outputs=true, register_pop_outputs=false)/' \
    -e '/^  chan _framebuffer_pixel_read_response\(/b' \
    -e '/^  chan _(framebuffer_pixel_(read|read_response|write|write_response)|read_(color|aux)(_response)?|write_(color|aux)(_response)?|(color|aux)_write_(command|response)|pixel_cache_(request|response|lookup)|texture_cache_response)\(/ s/\)$/\, fifo_depth=2, bypass=false, register_push_outputs=true, register_pop_outputs=false)/' \
    -e '/^  chan _(framebuffer_pixel_(read|read_response|write|write_response)|read_(color|aux)(_response)?|write_(color|aux)(_response)?|(color|aux)_write_(command|response)|pixel_cache_(request|response|lookup)|texture_cache_response)\(/b' \
    -e '/fifo_depth=/b' \
    -e '/^  chan _.*ops=send_receive/ s/\)$/\, fifo_depth=1, bypass=false, register_push_outputs=true, register_pop_outputs=false)/' \
    "$proc_build/unoptimized.ir" >"$proc_build/fifo.ir"
  opt_main --output_path="$proc_build/hardware.ir" "$proc_build/fifo.ir"
  codegen_main \
    --generator=pipeline \
    --pipeline_stages=3 \
    --delay_model=asap7 \
    --worst_case_throughput=1 \
    --reset=rst \
    --fifo_module='' \
    --materialize_internal_fifos \
    --flop_inputs=false \
    --flop_outputs=false \
    --gate_recvs=false \
    --module_name=CoreSimDe10 \
    --output_verilog_path="$proc_build/CoreSimDe10.sv" \
    --output_block_ir_path="$proc_build/block.ir" \
    --output_signature_path="$proc_build/signature.textproto" \
    --output_schedule_path="$proc_build/schedule.textproto" \
    "$proc_build/hardware.ir"
  "$root/scripts/quartus-compat-xls-rtl" "$proc_build/CoreSimDe10.sv"
  exit
fi

if [[ "${1:-}" == "--hosted-proc" ]]; then
  proc_build="$build/core_sim_hosted_rtl"
  mkdir -p "$proc_build"
  ir_converter_main \
    --dslx_path="$root/xls/dslx" \
    --top=core_sim_hosted \
    --lower_to_proc_scoped_channels \
    "$root/xls/dslx/core_sim.x" >"$proc_build/unoptimized.ir"
  sed -E \
    '/^  chan _(fill_line_request|fill_line_response|texture_cache_request|texture_cache_response|pixel_job|pixel_work|pixel_read_job|pixel_pending|pixel_result|pixel_cache_request|pixel_cache_response)\(/ s/\)$/\, fifo_depth=1, bypass=false, register_push_outputs=true, register_pop_outputs=false)/' \
    "$proc_build/unoptimized.ir" >"$proc_build/fifo.ir"
  opt_main --output_path="$proc_build/hardware.ir" "$proc_build/fifo.ir"
  codegen_main \
    --generator=pipeline \
    --pipeline_stages=15 \
    --delay_model=unit \
    --worst_case_throughput=1 \
    --reset=rst \
    --fifo_module='' \
    --materialize_internal_fifos \
    --flop_inputs=false \
    --flop_outputs=false \
    --module_name=CoreSimHosted \
    --output_verilog_path="$proc_build/CoreSimHosted.sv" \
    --output_block_ir_path="$proc_build/block.ir" \
    --output_signature_path="$proc_build/signature.textproto" \
    --output_schedule_path="$proc_build/schedule.textproto" \
    "$proc_build/hardware.ir"
  exit
fi

sources=(pixel texture layout tmu raster)
for source in "${sources[@]}"; do
  dslx_fmt -i "$root/xls/dslx/$source.x"
  interpreter_main "$root/xls/dslx/$source.x"
done

generate() {
  local source="$1"
  local top="$2"
  local module="$3"
  ir_converter_main --top="$top" "$root/xls/dslx/$source.x" >"$build/$module.ir"
  opt_main "$build/$module.ir" >"$build/$module.opt.ir"
  codegen_main \
    --generator=combinational \
    --use_system_verilog=false \
    --module_name="$module" \
    --top="$top" \
    "$build/$module.opt.ir" >"$rtl/$module.v"
}

generate pixel framebuffer_address VoodooXlsFramebufferAddress
generate pixel write_pack VoodooXlsWritePack
generate pixel depth_compare VoodooXlsDepthCompare
generate pixel alpha_blend VoodooXlsAlphaBlend
generate pixel fog_w_depth VoodooXlsFogWDepth
generate pixel fog_table_factor VoodooXlsFogTableFactor
generate pixel fog_blend VoodooXlsFogBlend
generate pixel color_combine VoodooXlsColorCombine
generate pixel lfb_decode VoodooXlsLfbDecode
generate pixel pixel_tests VoodooXlsPixelTests
generate pixel data_swizzle VoodooXlsDataSwizzle
generate texture texel_decode VoodooXlsTexelDecode
generate texture texture_filter VoodooXlsTextureFilter
generate layout texture_layout VoodooXlsTextureLayout
generate tmu tmu_recip_meta VoodooXlsTmuRecipMeta
generate tmu tmu_recip VoodooXlsTmuRecip
generate tmu tmu_perspective_coords VoodooXlsTmuPerspectiveCoords
generate tmu tmu_gradient VoodooXlsTmuGradient
generate tmu tmu_lod_index VoodooXlsTmuLodIndex
generate tmu tmu_base_lod VoodooXlsTmuBaseLod
generate tmu tmu_lod_select VoodooXlsTmuLodSelect
generate tmu tmu_coordinates VoodooXlsTmuCoordinates
generate tmu tmu_addresses VoodooXlsTmuAddresses
generate tmu tmu_packed_decode VoodooXlsTmuPackedDecode
generate tmu texture_write_address VoodooXlsTextureWriteAddress
generate raster triangle_iter_load VoodooXlsTriangleIterLoad
generate raster triangle_iter_step VoodooXlsTriangleIterStep
generate raster signed_magnitude_16 VoodooXlsSignedMagnitude16
generate raster triangle_setup VoodooXlsTriangleSetup
generate raster triangle_setup_s16 VoodooXlsTriangleSetupS16
generate raster span_step VoodooXlsSpanStep

touch "$rtl/.stamp"
