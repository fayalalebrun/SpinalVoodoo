#!/usr/bin/env python3
import argparse
import gzip
import hashlib
import json
from pathlib import Path
import shutil
import struct
import subprocess
import tarfile

ROOT = Path(__file__).resolve().parent.parent


def command(*args):
    return subprocess.check_output(args, text=True).strip()


def arm_elf(path):
    with path.open("rb") as file:
        header = file.read(52)
    if len(header) != 52 or header[:6] != b"\x7fELF\x01\x01" or struct.unpack_from("<H", header, 18)[0] != 40:
        raise ValueError(f"not a little-endian ARM ELF32: {path}")
    if struct.unpack_from("<I", header, 36)[0] & 0x5000400 != 0x5000400:
        raise ValueError(f"not ARM EABI5 hard-float: {path}")


def dependencies(executable, runtime, glide):
    pending = [executable, runtime, glide]
    files = {"dosbox-x": executable, runtime.name: runtime, glide.name: glide}
    known = set()
    while pending:
        path = pending.pop()
        if path in known:
            continue
        known.add(path)
        arm_elf(path)
        directories = [runtime.parent, glide.parent, path.parent]
        for entry in command("patchelf", "--print-rpath", str(path)).split(":"):
            if entry:
                directory = Path(entry.replace("${ORIGIN}", str(path.parent)).replace("$ORIGIN", str(path.parent)))
                if not directory.is_absolute():
                    raise ValueError(f"relative library search path in {path}")
                directories.append(directory)
        needed = command("patchelf", "--print-needed", str(path)).splitlines()
        if path == executable:
            interpreter = Path(command("patchelf", "--print-interpreter", str(path)))
            directories.append(interpreter.parent)
            needed.append(interpreter.name)
        if path.name.startswith("libSDL2"):
            needed.append("libSDL3.so.0")
        for name in needed:
            if Path(name).name != name:
                raise ValueError(f"non-relocatable library name: {name}")
            match = next((directory / name for directory in directories if (directory / name).is_file()), None)
            if match is None:
                raise ValueError(f"unresolved dependency {name} from {path}")
            match = match.resolve()
            if name in files and files[name].resolve() != match:
                raise ValueError(f"conflicting dependency {name}")
            files[name] = match
            pending.append(match)
    return files


def archive(destination, entries):
    with destination.open("xb") as output, gzip.GzipFile(filename="", mode="wb", fileobj=output, mtime=0) as compressed:
        with tarfile.open(fileobj=compressed, mode="w") as tar:
            def normalize(info):
                info.uid = info.gid = info.mtime = 0
                info.uname = info.gname = ""
                return info
            for name, path in sorted(entries.items()):
                tar.add(path, arcname=name, filter=normalize)


def derivation_environment(metadata):
    derivations = metadata.get("derivations", metadata)
    if len(derivations) != 1:
        raise ValueError("expected exactly one Nix derivation")
    derivation = next(iter(derivations.values()))
    environment = derivation.get("structuredAttrs") or derivation.get("env", {})
    if not environment.get("src") or not environment.get("name"):
        raise ValueError("Nix derivation is missing source metadata")
    return environment


def sources(destination, files):
    directory = destination / "sources"
    directory.mkdir()
    names = subprocess.check_output(["git", "-C", str(ROOT), "ls-files", "--cached", "--others", "--exclude-standard", "-z"]).decode().split("\0")
    entries = {"worktree/" + name: ROOT / name for name in set(names)
               if name and "__pycache__" not in Path(name).parts and Path(name).suffix not in (".pyc", ".pyo")
               and (ROOT / name).is_file()}
    archive(directory / "worktree.tar.gz", entries)
    for project in ("template", "main", "dosbox-x"):
        upstream = ROOT / "output/mister/sources" / project
        names = subprocess.check_output(["git", "-C", str(upstream), "ls-files", "-z"]).decode().split("\0")
        archive(directory / (project + ".tar.gz"), {project + "/" + name: upstream / name for name in names if name})
    inventory = {}
    roots = {Path(*source.parts[:4]) for source in files.values() if str(source).startswith("/nix/store/")}
    for root in sorted(roots):
        derivations = sorted(command("nix-store", "--query", "--valid-derivers", str(root)).splitlines())
        if not derivations:
            raise ValueError(f"missing local derivation for {root}; enter the pinned ARM shell first")
        derivation = derivations[0]
        metadata = json.loads(command("nix", "derivation", "show", derivation))
        environment = derivation_environment(metadata)
        source = Path(environment["src"])
        command("nix-store", "--option", "substituters", "https://cache.nixos.org", "--realise", str(source))
        patches = environment.get("patches", [])
        patches = [Path(path) for path in (patches.split() if isinstance(patches, str) else patches)]
        members = {source.name: source}
        for patch in patches:
            command("nix-store", "--option", "substituters", "https://cache.nixos.org", "--realise", str(patch))
            members[patch.name] = patch
        archive(directory / (root.name + ".tar.gz"), members)
        (directory / (root.name + ".drv.json")).write_text(json.dumps(metadata, indent=2, sort_keys=True) + "\n")
        if source.is_dir():
            license_files = [str(path.relative_to(source)) for path in source.rglob("*")
                             if path.is_file() and path.name.upper().startswith(("COPYING", "COPYRIGHT", "LICENSE", "LICENCE"))]
        else:
            with tarfile.open(source) as tar:
                license_files = [name for name in tar.getnames() if Path(name).name.upper().startswith(("COPYING", "COPYRIGHT", "LICENSE", "LICENCE"))]
        if not license_files:
            raise ValueError(f"missing source license inventory: {source}")
        inventory[root.name] = {"name": environment["name"], "version": environment.get("version"),
                                "derivation": derivation, "source": str(source), "licenses": sorted(license_files)}
    (directory / "inventory.json").write_text(json.dumps(inventory, indent=2, sort_keys=True) + "\n")


def package(destination, build):
    destination = destination.resolve()
    build = build.resolve()
    if not destination.is_relative_to(ROOT / "output") or destination.exists():
        raise ValueError("bundle destination must be a fresh directory inside output")
    command("python3", "-B", str(ROOT / "scripts/prepare-mister-dosbox"), "--output", str(build), "--check")
    files = dependencies(build / "src/dosbox-x", ROOT / "output/mister/arm-runtime/libmister_runtime.so",
                         ROOT / "output/mister/arm-glide/libglide2x.so")
    destination.mkdir(parents=True)
    (destination / "bin").mkdir()
    (destination / "lib").mkdir()
    manifest = {}
    for name, source in sorted(files.items()):
        target = destination / ("bin" if name == "dosbox-x" else "lib") / name
        shutil.copyfile(source, target)
        target.chmod(0o755)
        if name != "ld-linux-armhf.so.3":
            command("patchelf", "--set-rpath", "$ORIGIN/../lib" if name == "dosbox-x" else "$ORIGIN", str(target))
        if name == "dosbox-x":
            command("patchelf", "--set-interpreter", "/opt/spinalvoodoo/lib/ld-linux-armhf.so.3", str(target))
        manifest[name] = {"source": str(source), "original_sha256": hashlib.sha256(source.read_bytes()).hexdigest()}
    (destination / "manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    for name in ("launch", "dosbox-x.conf", "asound.conf", "install"):
        shutil.copyfile(ROOT / "emu/mister" / name, destination / name)
        (destination / name).chmod(0o644 if name.endswith(".conf") else 0o755)
    sources(destination, files)
    (destination / "SHA256SUMS").write_text("".join(
        f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {path.relative_to(destination)}\n"
        for path in sorted(destination.rglob("*")) if path.is_file()))
    print(destination)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, default=ROOT / "output/mister/runtime")
    parser.add_argument("--dosbox-build", type=Path, default=ROOT / "output/mister/dosbox-final-build")
    args = parser.parse_args()
    try:
        package(args.output, args.dosbox_build)
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        parser.exit(1, f"{error}\n")


if __name__ == "__main__":
    main()
