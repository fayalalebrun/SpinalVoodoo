#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
build="$root/xls/build"
ir="$build/core_sim_hosted.ir"
proto="$build/core_sim_hosted.pb"
library="$build/core_sim_hosted.so"
log="${XLS_BRIDGE_LOG:-$build/dosbox-xls-server.log}"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/spinalvoodoo-xls.XXXXXX")"
socket="$tmp/bridge.sock"
server_pid=""

cleanup() {
  if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
    kill "$server_pid" 2>/dev/null || true
  fi
  if [[ -n "$server_pid" ]]; then
    wait "$server_pid" 2>/dev/null || true
  fi
  rm -rf "$tmp"
}
trap cleanup EXIT INT TERM

nix build "path:$root#xls"
"$root/scripts/replay-pure-xls-proc-trace" --generate-only \
  --native-ir "$ir" "$root/traces/test28.bin"
runtime="${XLS_RUNTIME_BIN:-$root/result/bin/voodoo_xls_runtime}"
mkdir -p "$(dirname "$log")"
"$runtime" "$ir" "--server=$socket" \
  "--aot_proto=$proto" "--aot_library=$library" \
  "--max_ticks=${XLS_BRIDGE_MAX_TICKS:-20000000}" >"$log" 2>&1 &
server_pid=$!

for _ in $(seq 1 500); do
  [[ -S "$socket" ]] && break
  kill -0 "$server_pid" 2>/dev/null || {
    cat "$log" >&2
    exit 1
  }
  sleep 0.01
done
[[ -S "$socket" ]] || {
  cat "$log" >&2
  exit 1
}

SIM_XLS_SOCKET="$socket" "$root/scripts/run-dosboxx32-glide" "$@"
wait "$server_pid"
server_pid=""
