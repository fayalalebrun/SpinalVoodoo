#!/usr/bin/env python3
import re
import subprocess
import tempfile
from pathlib import Path

root = Path(__file__).resolve().parent.parent
source = root / "xls/build/core_sim_de10_rtl/CoreSimDe10.register-fifos.sv"
compat = root / "scripts/quartus-compat-xls-rtl"
with tempfile.TemporaryDirectory(prefix="ram-fifo-test-", dir=root / "xls/build") as directory:
    work = Path(directory)
    reference = work / "reference.sv"
    candidate = work / "candidate.sv"
    reference.write_bytes(source.read_bytes())
    candidate.write_bytes(source.read_bytes())
    subprocess.run([compat, reference], check=True)
    subprocess.run([compat, candidate, "--ram-fifos"], check=True)
    raw = reference.read_text()
    lowered = candidate.read_text()
    subprocess.run([compat, candidate, "--ram-fifos"], check=True)
    assert candidate.read_text() == lowered
    tests = []
    modules = []
    fifo_names = [re.search(r"^\s+(\w+) materialized_fifo_fifo__" + channel + r"_\s*\(", raw, re.M)[1]
                  for channel in ("pixel_work", "pixel_texture", "pixel_cache_request", "pixel_read_job", "palette_pending")]
    single_slots = re.findall(r"^module (fifo_for_depth_1_ty_\w+_no_bypass_register_push(?:___\d+)?)\(", raw, re.M)
    two_slots = [name for name in re.findall(
        r"^module (fifo_for_depth_2_ty_\w+_no_bypass_register_push(?:___\d+)?)\(", raw, re.M)
                 if name not in fifo_names]
    assert single_slots and two_slots
    for index, name in enumerate(fifo_names + single_slots + two_slots):
        channel = re.search(r"^\s+" + name + r" materialized_fifo_fifo__(\w+)_\s*\(", raw, re.M)[1]
        pattern = r"module " + name + r"\(.*?endmodule"
        original = re.search(pattern, raw, re.S)[0]
        replacement = re.search(pattern, lowered, re.S)[0]
        width = int(re.search(r"input wire \[(\d+):0\] push_data", original)[1]) + 1
        if name in single_slots:
            assert re.findall(r"reg (?:\[\d+:0\] )?(\w+);", replacement) == ["full", "data"], channel
        if name in two_slots:
            assert f"reg [{width - 1}:0] memory [0:1];" in replacement, channel
        modules += [original.replace(name, f"Reference{index}", 1),
                    replacement.replace(name, f"Candidate{index}", 1)]
        tests.append(f'''
  reg [{width - 1}:0] input{index} = 0;
  wire ready{index}, reference_ready{index}, valid{index}, reference_valid{index};
  wire [{width - 1}:0] output{index}, reference_output{index};
  Reference{index} reference{index}(.clk(clk), .rst(rst), .push_valid(push), .pop_ready(pop),
    .push_data(input{index}), .push_ready(reference_ready{index}),
    .pop_valid(reference_valid{index}), .pop_data(reference_output{index}));
  Candidate{index} candidate{index}(.clk(clk), .rst(rst), .push_valid(push), .pop_ready(pop),
    .push_data(input{index}), .push_ready(ready{index}), .pop_valid(valid{index}), .pop_data(output{index}));
  always @(negedge clk) begin
    if (cycle > 2) begin
      if (ready{index} !== reference_ready{index} || valid{index} !== reference_valid{index})
        $fatal(1, "{channel} handshake mismatch at %0d", cycle);
      if (valid{index} && output{index} !== reference_output{index})
        $fatal(1, "{channel} data mismatch at %0d", cycle);
    end
    if (ready{index}) input{index} <= {{{width}{{1'b1}}}} ^ ({width}'(cycle) * {width}'(32'h1234567));
  end
''')
    bench = "\n".join(modules) + '''
module RamFifoTest;
  reg clk = 0, rst = 1, push = 0, pop = 0;
  integer cycle = 0;
  always #5 clk = !clk;
''' + "\n".join(tests) + '''
  always @(negedge clk) begin
    cycle <= cycle + 1;
    rst <= cycle < 3 || cycle % 257 == 0;
    push <= cycle < 50 || (cycle >= 100 && $urandom_range(0, 3) != 0);
    pop <= cycle >= 50 && (cycle < 100 || $urandom_range(0, 3) != 0);
    if (cycle == 10000) begin
      $display("RAM FIFO cycle equivalence PASS");
      $finish;
    end
  end
endmodule
'''
    (work / "test.sv").write_text(bench)
    subprocess.run(["verilator", "--binary", "--timing", "--top-module", "RamFifoTest",
                    "--Mdir", str(work / "build"), "-j", "8", "-Wno-WIDTHTRUNC",
                    "-Wno-WIDTHEXPAND", str(work / "test.sv")], check=True,
                   stdout=subprocess.DEVNULL)
    subprocess.run([work / "build/VRamFifoTest"], check=True)
    for text, arguments in (("module Empty; endmodule\n", ["--ram-fifos"]),
                            (raw, ["--unsupported"]),
                            (raw.replace("no_bypass_register_pop_register_push", "with_bypass"),
                             ["--ram-fifos"])):
        candidate.write_text(text)
        result = subprocess.run([compat, candidate, *arguments], capture_output=True)
        assert result.returncode != 0
        assert candidate.read_text() == text
    print("RAM FIFO invalid-input guards PASS")
