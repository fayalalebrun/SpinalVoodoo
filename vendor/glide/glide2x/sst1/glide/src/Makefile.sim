.PHONY: all clean
.SUFFIXES: .c .o

FX_GLIDE_HW = sst1
GLIDE_ROOT = ../../../..
FX_GLIDE_SW = $(GLIDE_ROOT)/swlibs

GLIDE_LIBDIR = ../../lib$(FX_GLIDE_HW)

SIM_DIR = ../../../../../../software/simulation/xls
PURE_XLS ?= $(if $(filter 1,$(TRACE_CAPTURE)),0,1)
BACKEND_MODE_FILE = $(SIM_DIR)/obj_dir/.glide_backend_mode
BACKEND_MODE = $(if $(filter 1,$(PURE_XLS)),xls,trace)
$(shell mkdir -p $(dir $(BACKEND_MODE_FILE)))
$(shell [ -f $(BACKEND_MODE_FILE) ] && [ "$$(cat $(BACKEND_MODE_FILE))" = "$(BACKEND_MODE)" ] || printf '%s\n' "$(BACKEND_MODE)" > $(BACKEND_MODE_FILE))

GLIDE_LIB = libglide2x.a
GLIDE_SHARED = libglide2x.so.2
GLIDE_SONAME = libglide2x.so.2
GLIDE_SO = libglide2x.so

###############################################################################
#	tools
###############################################################################

# Use 32-bit compiler: CC32 env var (from devenv) or fall back to gcc -m32
CC = $(if $(CC32),$(CC32),gcc -m32)
CXX = $(if $(CXX32),$(CXX32),g++ -m32)
AR = ar
ZLIB_LIBS ?= -lz
X11_CFLAGS ?=
X11_LIBS ?= -lX11 -lXext

###############################################################################
#	defines
###############################################################################

CDEFS = -DINIT_LINUX
CDEFS += -DSIM_BACKEND
ifeq ($(PURE_XLS),1)
CDEFS += -DPURE_XLS_BACKEND
endif
CDEFS += -DGLIDE_HARDWARE -DGLIDE_DEFAULT_GAMMA=1.3f -DGLIDE_LIB=1
CDEFS += -DSST1
CDEFS += -DGLIDE_USE_C_TRISETUP
# GLIDE_PLUG and GLIDE_SPLASH disabled in sim mode (no splash screen needed)

###############################################################################
#	flags
###############################################################################

ARFLAGS = rus

CFLAGS = -Wall -g -Wno-incompatible-pointer-types -Wno-int-conversion -Wno-error=format-security
CFLAGS += $(X11_CFLAGS)
CFLAGS += -I. -I../../incsrc -I../../init -I../../init/initvg
CFLAGS += -I$(FX_GLIDE_SW)/fxmisc -I$(FX_GLIDE_SW)/newpci/pcilib -I$(FX_GLIDE_SW)/fxmemmap
CFLAGS += -I$(SIM_DIR)/harness
CFLAGS += $(CDEFS)
CFLAGS += -O1 -ffast-math

###############################################################################
#	objects
###############################################################################

GLIDE_OBJECTS = \
	gsplash.o \
	g3df.o  \
	gu.o \
	guclip.o \
	gpci.o \
	gump.o \
	diglide.o \
	disst.o \
	ditex.o \
	gbanner.o \
	gerror.o \
	gmovie.o \
	digutex.o \
	ddgump.o \
	gaa.o \
	gdraw.o \
	gglide.o \
	glfb.o \
	gsst.o \
	gtex.o \
	gtexdl.o \
	gutex.o \
	gx11present.o \
	gxdraw.o \
	cpuid.o

INIT_OBJECTS = \
	../../init/init.o \
	../../init/gdebug.o \
	../../init/vgdrvr.o \
	../../init/initvg/gamma.o \
	../../init/initvg/dac.o \
	../../init/initvg/video.o \
	../../init/initvg/parse.o \
	../../init/initvg/sli.o \
	../../init/initvg/util.o \
	../../init/initvg/info.o \
	../../init/initvg/print.o \
	../../init/initvg/sst1init.o

# Use fxsim.o instead of fxlinux.o for simulation backend
GLIDE_OBJECTS += \
	$(INIT_OBJECTS) \
	$(FX_GLIDE_SW)/newpci/pcilib/sst1_pci.o \
	$(FX_GLIDE_SW)/newpci/pcilib/fxmsr.o \
	$(FX_GLIDE_SW)/newpci/pcilib/fxpci.o \
	$(FX_GLIDE_SW)/newpci/pcilib/fxsim.o

GLIDE_OBJECTS += \
	$(FX_GLIDE_SW)/fxmisc/fxos.o \
	$(FX_GLIDE_SW)/fxmisc/fximg.o

# Backend objects (built by software/simulation/xls/Makefile)
ifeq ($(PURE_XLS),1)
BACKEND_OBJ = $(SIM_DIR)/obj_dir/sim_harness_xls.o
BACKEND_LIB =
BACKEND_DEPS = $(BACKEND_OBJ)
else
BACKEND_OBJ = \
	$(SIM_DIR)/obj_dir/sim_trace_harness.o \
	$(SIM_DIR)/obj_dir/voodoo_trace_writer.o
BACKEND_LIB =
BACKEND_DEPS = $(BACKEND_OBJ)
endif

###############################################################################
#	targets
###############################################################################

all: $(GLIDE_LIBDIR) $(GLIDE_LIBDIR)/$(GLIDE_LIB) $(GLIDE_LIBDIR)/$(GLIDE_SO)

$(GLIDE_OBJECTS): fxinline.h fxgasm.h $(BACKEND_MODE_FILE)

###############################################################################
#	rules
###############################################################################

.c.o:
	$(CC) -o $@ $(CFLAGS) -c $<

fxinline.h:
	printf '%s\n' '#ifndef __FX_INLINE_H__' '#define __FX_INLINE_H__' '' '/* The # of 2-byte entries in the hw fog table */' '#define kInternalFogTableEntryCount 0x40' '' '#endif /* __FX_INLINE_H__ */' > $@

fxgasm.h:
	: > $@

# CPU detection stub for sim mode (no x87/CPUID needed)
cpuid.o: cpudetect_sim.c
	$(CC) -o $@ $(CFLAGS) -c $<

$(GLIDE_LIBDIR):
	mkdir -p $@

$(GLIDE_LIBDIR)/$(GLIDE_LIB): $(GLIDE_OBJECTS)
	$(AR) $(ARFLAGS) $@ $^

$(GLIDE_LIBDIR)/$(GLIDE_SO): $(GLIDE_OBJECTS) $(BACKEND_DEPS)
	$(CXX) -o $(GLIDE_LIBDIR)/$(GLIDE_SHARED) -shared -Wl,-soname,$(GLIDE_SONAME) \
		$(GLIDE_OBJECTS) $(BACKEND_OBJ) \
		$(BACKEND_LIB) \
		-lm -lstdc++ $(ZLIB_LIBS) $(X11_LIBS)
	ln -fs $(GLIDE_SHARED) $@

clean:
	rm -f $(GLIDE_OBJECTS)
	rm -f fxinline.h fxgasm.h $(BACKEND_MODE_FILE)
	rm -f $(GLIDE_LIBDIR)/$(GLIDE_LIB) $(GLIDE_LIBDIR)/$(GLIDE_SHARED) $(GLIDE_LIBDIR)/$(GLIDE_SO)
