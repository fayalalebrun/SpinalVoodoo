#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
newer_source() {
  local output="$1"
  shift
  find "$@" \( -path '*/generated' -o -path '*/generated/*' \) -prune -o \
    -type f \( -name '*.x' -o -name '*.scala' -o -name '*.tcl' -o -name '*.qsys' \) \
    -newer "$output" -print -quit | grep -q .
}

rtl_outputs=(
  "$root/build/generated/xls/work/core_sim_de10_rtl/CoreSimDe10.sv"
  "$root/build/generated/scala/de10/XlsDe10Scanout.v"
  "$root/build/generated/scala/de10/XlsAvalonTransferMasterCore.v"
)
rtl_current=1
for output in "${rtl_outputs[@]}"; do
  if [[ ! -s "$output" || "$root/workflows/build/gen-rtl-de10-xls" -nt "$output" ||
        "$root/workflows/build/generate-xls-rtl" -nt "$output" ||
        "$root/workflows/build/gen-rtl-de10" -nt "$output" || "$root/project.scala" -nt "$output" ]] ||
     newer_source "$output" "$root/hardware/renderer/dslx" "$root/hardware/shared/scala" "$root/hardware/platforms/de10/scala"; then
    rtl_current=0
  fi
done
if [[ "${DE10_SKIP_RTL_GEN:-0}" != "1" && "$rtl_current" != "1" ]]; then
  "$root/workflows/build/gen-rtl-de10-xls"
fi

soc_qip="$root/build/generated/qsys/de10/synthesis/de10_soc.qip"
core_pll_qip="$root/build/generated/qsys/de10/pll/synthesis/de10_core_pll.qip"
hdmi_pll_qip="$root/build/generated/qsys/de10/hdmi_pll/synthesis/de10_hdmi_pll.qip"
qsys_current=1
if [[ ! -s "$soc_qip" || ! -s "$core_pll_qip" || ! -s "$hdmi_pll_qip" ||
      "$root/workflows/build/gen-qsys-de10" -nt "$soc_qip" ||
      "$root/hardware/platforms/de10/qsys/create_de10_soc.tcl" -nt "$soc_qip" ||
      "$root/hardware/platforms/de10/qsys/de10_soc.qsys" -nt "$soc_qip" ||
      "$root/hardware/platforms/de10/qsys/create_de10_core_pll.tcl" -nt "$core_pll_qip" ||
      "$root/hardware/platforms/de10/qsys/de10_core_pll.qsys" -nt "$core_pll_qip" ||
      "$root/hardware/platforms/de10/qsys/de10_hdmi_pll.qsys" -nt "$hdmi_pll_qip" ]]; then
  qsys_current=0
fi

DE10_CORE_CLOCK_MHZ="${DE10_CORE_CLOCK_MHZ:-27.0}" \
DE10_PROJECT_NAME=SpinalVoodoo_de10_xls \
DE10_OUT_DIR="${DE10_XLS_OUT_DIR:-$root/output/de10/xls-bitstream}" \
DE10_SKIP_RTL_GEN=1 \
DE10_SKIP_QSYS_GEN="${DE10_SKIP_QSYS_GEN:-$qsys_current}" \
"$root/workflows/build/build-bitstream-de10" "$@"
