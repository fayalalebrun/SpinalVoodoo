#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"
bundle="$(realpath "${1:-build/packages/mister-runtime}")"
nix develop --ignore-environment --keep HOME --keep USER --option substituters https://cache.nixos.org .#mister-arm --command bash -c '
  set -euo pipefail
  mkdir -p output/mister/arm-smoke
  "$CC" -std=c11 -O2 -Wall -Wextra -Werror -pedantic -pthread software/runtime/mister/arm_abi_test.c \
    -Lbuild/host/mister-arm-runtime -lmister_runtime -ldl -o output/mister/arm-smoke/abi
  "$CC" -std=c11 -O2 -Wall -Wextra -Werror -pedantic -pthread -fPIC -shared \
    software/integrations/dosbox/dosbox_smoke_runtime.c -o output/mister/arm-smoke/dosbox_runtime.so
'
nix develop --ignore-environment --keep HOME --keep USER --option substituters https://cache.nixos.org --command bash -c '
  set -euo pipefail
  bundle="$1"
  root="$PWD"
  export HOME="$root/output/mister/arm-smoke/home" SDL_VIDEODRIVER=dummy SDL_VIDEO_DRIVER=dummy
  export SDL_AUDIODRIVER=dummy SDL_AUDIO_DRIVER=dummy
  mkdir -p "$HOME"
  timeout 30 qemu-arm -strace "$bundle/lib/ld-linux-armhf.so.3" --library-path "$bundle/lib" \
    output/mister/arm-smoke/abi > output/mister/arm-smoke/abi.log 2>&1
  grep MISTER_ARM_ABI output/mister/arm-smoke/abi.log
  if grep -E "open(at)?\\(.*\"/dev/(mem|input|hidraw|bus/usb)" output/mister/arm-smoke/abi.log; then exit 1; fi

  timeout 60 qemu-arm -E "LD_PRELOAD=$root/output/mister/arm-smoke/dosbox_runtime.so" \
    "$bundle/lib/ld-linux-armhf.so.3" --library-path "$bundle/lib" "$bundle/bin/dosbox-x" \
    -conf "$bundle/dosbox-x.conf" \
    -c "echo MiSTer smoke" -c exit > output/mister/arm-smoke/dosbox.log 2>&1
  grep MISTER_DOSBOX_SMOKE output/mister/arm-smoke/dosbox.log
' bash "$bundle"
