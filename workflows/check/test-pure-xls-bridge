#!/usr/bin/env python3
import os
import pathlib
import socket
import struct
import subprocess
import tempfile
import time

MAGIC = 0x584C5342
ROOT = pathlib.Path(__file__).resolve().parents[2]
BUILD = ROOT / "xls" / "build"
IR = BUILD / "core_sim_hosted.ir"
PROTO = BUILD / "core_sim_hosted.pb"
LIBRARY = BUILD / "core_sim_hosted.so"
RUNTIME = pathlib.Path(os.environ.get("XLS_RUNTIME_BIN", ROOT / "result/bin/voodoo_xls_runtime"))


def start_server(path):
    process = subprocess.Popen([
        str(RUNTIME), str(IR), f"--server={path}",
        f"--aot_proto={PROTO}", f"--aot_library={LIBRARY}",
        "--max_ticks=20000000",
    ], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for _ in range(500):
        if path.exists():
            return process
        if process.poll() is not None:
            raise RuntimeError(process.stdout.read())
        time.sleep(0.01)
    process.terminate()
    raise RuntimeError("bridge socket was not created")


def exchange(connection, operation, address=0, data=0, count=0, mask=0, payload=b""):
    connection.sendall(struct.pack("<6I", MAGIC, operation, address, data, count, mask) + payload)
    response = b""
    while len(response) != 24:
        chunk = connection.recv(24 - len(response))
        if not chunk:
            raise RuntimeError("bridge response ended early")
        response += chunk
    magic, status, value, size, ticks = struct.unpack("<4IQ", response)
    body = b""
    while len(body) != size:
        chunk = connection.recv(size - len(body))
        if not chunk:
            raise RuntimeError("bridge payload ended early")
        body += chunk
    if magic != MAGIC:
        raise RuntimeError("invalid bridge response magic")
    return status, value, body, ticks


def connect(path):
    connection = socket.socket(socket.AF_UNIX)
    connection.connect(str(path))
    return connection


def main():
    subprocess.run(["nix", "build", f"path:{ROOT}#xls"], check=True)
    os.environ["PATH"] = f"{ROOT / 'result/bin'}{os.pathsep}{os.environ.get('PATH', '')}"
    subprocess.run([
        str(ROOT / "workflows/run/replay-pure-xls-proc-trace"), "--generate-only",
        "--native-ir", str(IR), str(ROOT / "verification/fixtures/traces/test28.bin"),
    ], check=True)
    with tempfile.TemporaryDirectory(prefix="spinalvoodoo-xls-test-") as directory:
        path = pathlib.Path(directory) / "bridge.sock"
        process = start_server(path)
        with connect(path) as connection:
            assert exchange(connection, 1, 0x214, 10 << 4, mask=0xF)[0] == 0
            payload = struct.pack("<I", 0x56781234)
            assert exchange(connection, 4, count=1, payload=payload)[0] == 0
            status, _, body, _ = exchange(connection, 3, count=1)
            assert status == 0 and body == payload
            status, _, body, _ = exchange(connection, 8, 2, 1)
            assert status == 0 and body == struct.pack("<HH", 0x1234, 0x5678)
            status, value, _, ticks = exchange(connection, 2, 0)
            assert status == 0 and value & 0x3F == 0x3F
            assert exchange(connection, 13)[0] == 0
        output = process.communicate(timeout=10)[0]
        if process.returncode != 0:
            raise RuntimeError(output)
        path = pathlib.Path(directory) / "invalid.sock"
        process = start_server(path)
        with connect(path) as connection:
            status, _, _, _ = exchange(connection, 3, 4 * 1024 * 1024, count=1)
            assert status != 0
        output = process.communicate(timeout=10)[0]
        if process.returncode == 0 or "out of bounds" not in output:
            raise RuntimeError(output)
    print(f"pure-XLS bridge smoke passed, ticks={ticks}")


if __name__ == "__main__":
    main()
